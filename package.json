{
  "name": "yfnhanced-mcp",
  "version": "2.0.0",
  "description": "Yahoo Finance MCP Server - A Model Context Protocol server for financial data with enterprise-grade resilience, circuit breaker, rate limiting, and data quality validation",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "y-finance-mcp": "./dist/index.js",
    "yfnhanced-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "jest",
    "test:live": "jest --config jest.live.config.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "clean": "node -e \"const fs = require('fs'); if (fs.existsSync('dist')) { fs.rmSync('dist', { recursive: true, force: true }); }\"",
    "prepublishOnly": "npm run clean && npm run build && npm run readme:npm",
    "prepack": "npm run build",
    "readme:npm": "node -e \"const fs = require('fs'); fs.copyFileSync('NPM-README.md', 'README.md');\"",
    "readme:github": "node -e \"const fs = require('fs'); fs.copyFileSync('GITHUB-README.md', 'README.md');\""
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "yahoo-finance",
    "finance",
    "stocks",
    "financial-data",
    "circuit-breaker",
    "rate-limiting",
    "api-resilience",
    "data-quality"
  ],
  "author": "Kanishka Namdeo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kanishka-namdeo/yfnhanced-mcp.git"
  },
  "homepage": "https://github.com/kanishka-namdeo/yfnhanced-mcp#readme",
  "bugs": {
    "url": "https://github.com/kanishka-namdeo/yfnhanced-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "yahoo-finance2": "^4.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.12.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.0.0"
  }
}
